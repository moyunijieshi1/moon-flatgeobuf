import {
  "moyunijieshi1/moon-flatgeobuf" @fgb,
  "moonbitlang/core/json",
}

options(
  link: {
    "js": {
      "exports": [
        "encode",
        "decode",
        "inspect",
        "query",
        "audit",
        "start_remote",
        "next_remote",
        "accept_remote",
        "result_remote",
        "stats_remote",
        "summary",
        "report",
        "native_transcode",
        "native_query_count",
        "native_query",
        "native_inspect",
        "native_validate",
        "native_stream_transcode",
        "start_native_remote",
        "next_native_remote",
        "accept_native_remote",
        "result_native_remote",
        "stats_native_remote",
      ],
      "format": "cjs",
    },
  },
)
