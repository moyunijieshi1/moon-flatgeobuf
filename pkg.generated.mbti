  header_ : Header
  limits : Limits
  index_start : Int32
  index_size : Int32
  features_start : Int32
  mut cursor : Int32
  mut ordinal : Int32
}
pub fn Reader::at(Self, Int32) -> FeatureRecord raise FgbError
pub fn Reader::feature_section_offset(Self) -> Int32
pub fn Reader::has_index(Self) -> Bool
pub fn Reader::header(Self) -> Header
pub fn Reader::next(Self) -> FeatureRecord? raise FgbError
pub fn Reader::open(Bytes, limits? : Limits) -> Self raise FgbError
pub fn Reader::query(Self, Bounds) -> Array[FeatureRecord] raise FgbError
pub fn Reader::read_all(Self) -> Dataset raise FgbError
pub fn Reader::rewind(Self) -> Unit
pub fn Reader::select(Self, Selection) -> Dataset raise FgbError
pub fn Reader::validate(Self) -> Unit raise FgbError

#derive(Eq, @debug.Debug, @json.FromJson, @json.ToJson)
pub(all) struct SchemaDifference {
  column : String
  message : String
}
pub fn SchemaDifference::equal(Self, Self) -> Bool
pub fn SchemaDifference::from_json(@json.Json, @json.JsonPath) -> Self raise @json.JsonDecodeError
pub fn SchemaDifference::not_equal(Self, Self) -> Bool
pub fn SchemaDifference::to_json(Self) -> @json.Json
pub fn SchemaDifference::to_repr(Self) -> @debug.Repr

#derive(Eq, @debug.Debug)
pub(all) struct Selection {
  bounds : Bounds?
  predicate : Predicate?
  fields : Array[String]?
  offset : Int32
  limit : Int32
}
pub fn Selection::all() -> Self
pub fn Selection::equal(Self, Self) -> Bool
pub fn Selection::not_equal(Self, Self) -> Bool
pub fn Selection::to_repr(Self) -> @debug.Repr

pub struct StreamDecoder {
  limits : Limits
  mut stage : DecodeStage
  mut buffer : ByteWriter
  mut header_ : Header?
  mut total_received : Int32
  mut ordinal : Int32
  mut feature_offset : Int32
  mut closed : Bool
  mut failed : Bool
  mut native_mode : Bool
  mut native_header_ : NativeHeader?
  native_records : Array[NativeFeatureRecord]
}
pub fn StreamDecoder::buffered_bytes(Self) -> Int32
pub fn StreamDecoder::features_decoded(Self) -> Int32
pub fn StreamDecoder::finish(Self) -> Unit raise FgbError
pub fn StreamDecoder::header(Self) -> Header?
pub fn StreamDecoder::is_failed(Self) -> Bool
pub fn StreamDecoder::new(limits? : Limits) -> Self raise FgbError
pub fn StreamDecoder::push(Self, Bytes) -> Array[FeatureRecord] raise FgbError

pub struct StreamWriter {
  header_ : Header
  limits : Limits
  mut started : Bool
  mut closed : Bool
  mut feature_count : Int32
  mut total_bytes : Int32
}
pub fn StreamWriter::append(Self, Feature) -> Bytes raise FgbError
pub fn StreamWriter::begin(Self) -> Bytes raise FgbError
pub fn StreamWriter::bytes_written(Self) -> Int32
pub fn StreamWriter::features_written(Self) -> Int32
pub fn StreamWriter::finish(Self) -> Unit raise FgbError
pub fn StreamWriter::new(Header, limits? : Limits) -> Self raise FgbError

